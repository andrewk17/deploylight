// Serves docs/ on the custom domain and redirects the former workers.dev address.
{
  "name": "deploylight",
  "compatibility_date": "2026-05-01",
  "main": "site/worker.js",
  "workers_dev": true,
  "routes": [
    { "pattern": "deploylight.andrewkim.me", "custom_domain": true }
  ],
  "preview_urls": false,
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash"
  }
}
